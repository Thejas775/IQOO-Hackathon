*.iml
.gradle
/local.properties
local.properties
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
.kotlin/

# IDE state — machine-specific, nothing here belongs in history
.idea/

# Secrets / signing
*.jks
*.keystore
key.properties
google-services.json
secrets.properties

# Build outputs
*.apk
*.aab
*.ap_

# Model weights. These are multi-GB LFS objects downloaded at runtime from
# Hugging Face (see ModelCatalog) — they must never enter git history, where
# they would be permanent and would make the repo unclonable.
*.litertlm
*.task
*.tflite
*.bin
*.part

# ...with one deliberate exception. The MobileBERT embedder is 26 MB and is
# bundled in the APK rather than downloaded, so it has to be in the repo: a
# fresh clone without it builds an app whose dedup and retrieval silently
# degrade, with no error to explain why. Small enough that git handles it
# fine, unlike the multi-GB weights above.
!app/src/main/assets/bert_embedder.tflite

# Supabase CLI local state (may contain project link/session info)
supabase/.temp/
supabase/.branches/
