<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 counterpart to data_extraction_rules.xml. Unreachable at
    minSdk 29 only because allowBackup is false, but kept correct rather than
    left as the template: if allowBackup is ever flipped on, this file is what
    decides whether the memory store goes with it.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
