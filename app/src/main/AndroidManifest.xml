<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used to fetch the Gemma model from Hugging Face, once. Inference
         itself is fully on-device and never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Read-only, and never written back. The Calendar tab merges real device
         events alongside captured commitments so the month is the user's whole
         day rather than only what DailyFlow overheard. Optional at runtime:
         without it the tab still works, showing captured items only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".DailyFlowApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyFlow">

        <!-- OpenCL is what lets LiteRT-LM run Gemma on the GPU (Adreno/Mali).
             Optional so the APK still installs on devices without it — the
             engine falls back to CPU at runtime. Without these the GPU backend
             silently fails to load and every run measures CPU speed instead. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!-- Lets the system camera app write a captured photo into our cache.
             Note the app deliberately does NOT declare the CAMERA permission:
             ACTION_IMAGE_CAPTURE needs no grant unless the manifest asks for
             it, so staying silent keeps the flow permission-free. -->
        <!--
            The capture service. Guarded by BIND_ACCESSIBILITY_SERVICE so only
            the system can bind to it, and exported because the system is a
            different process — that pair is required, not a loosening.
        -->
        <service
            android:name=".capture.CaptureService"
            android:exported="true"
            android:label="@string/capture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capture_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DailyFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>